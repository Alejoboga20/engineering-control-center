# Engineering Control Center. See "Deploying on Ubuntu" in README.md.
#
# Replace before installing:
#   dev                     the unprivileged user that owns your projects and Claude credentials
#   /home/dev/engineering-control-center    the path of this repository
#   v22.0.0                 your exact nvm Node version, from: nvm which 22

[Unit]
Description=Engineering Control Center
After=network.target

[Service]
Type=simple
User=dev
WorkingDirectory=/home/dev/engineering-control-center

# systemd loads no shell profile, so nvm is not available. Both paths must be absolute.
ExecStart=/home/dev/.nvm/versions/node/v22.0.0/bin/node /home/dev/engineering-control-center/apps/api/dist/main.js

Environment=NODE_ENV=production
Environment=LANG=C.UTF-8
# Shells in sessions created while no tmux server is running inherit this PATH as a starting point.
Environment=PATH=/home/dev/.nvm/versions/node/v22.0.0/bin:/home/dev/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/dev
# Optional overrides, such as ECC_PROJECT_ROOTS, ECC_DATA_DIR and the ECC_GITHUB_* settings. The
# Inbox database defaults to $HOME/.local/share/engineering-control-center, which needs HOME above.
# The leading "-" permits the file to be absent.
EnvironmentFile=-/etc/engineering-control-center.env

Restart=on-failure
RestartSec=3
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=engineering-control-center

# ---- These settings keep terminal sessions alive. Do not remove them. ----
#
# The dashboard may be the process that starts the tmux server, which places that server, and
# every Claude Code process in it, inside this service's cgroup. With the default
# KillMode=control-group, each restart or stop of this service would kill them all.
KillMode=process
# By default, when the kernel OOM killer takes any process in the cgroup, systemd stops the whole
# unit, which would kill every session because one process in one of them ran out of memory.
OOMPolicy=continue

# Sandboxing options are deliberately absent. Processes in sessions inherit them through the tmux
# server, which would break real work: PrivateTmp gives this service a different tmux socket from
# your SSH logins, ProtectHome hides your projects, and NoNewPrivileges disables sudo.

[Install]
WantedBy=multi-user.target
