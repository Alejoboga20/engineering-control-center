{
  "name": "engineering-control-center",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted dashboard for persistent tmux terminal sessions",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @ecc/shared build && concurrently -k -n api,web -c cyan,magenta \"pnpm --filter @ecc/api dev\" \"pnpm --filter @ecc/web dev\"",
    "build": "pnpm -r build",
    "start": "NODE_ENV=production node apps/api/dist/main.js",
    "test": "pnpm --filter @ecc/shared build && pnpm -r test",
    "lint": "pnpm --filter @ecc/shared build && eslint .",
    "typecheck": "pnpm --filter @ecc/shared build && pnpm -r typecheck",
    "claude-hooks": "node scripts/claude-hooks.cjs",
    "inbox": "node scripts/inbox.cjs",
    "inbox-mcp": "node scripts/inbox.cjs mcp"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty",
      "esbuild",
      "@nestjs/core",
      "better-sqlite3"
    ]
  }
}
