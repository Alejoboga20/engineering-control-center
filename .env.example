# Engineering Control Center configuration.
# Development: export these in your shell. Production: /etc/engineering-control-center.env

# Comma-separated absolute directories in which sessions may be created. Symlinks are
# resolved before checking. If unset, defaults to ~/projects.
ECC_PROJECT_ROOTS=/home/dev/projects

# Bind address and port. Keep the address on loopback and reach it through an SSH tunnel.
ECC_HOST=127.0.0.1
ECC_PORT=3000

# Comma-separated origins allowed to call the API and open terminals. Add one when you
# forward to a different local port, or when using Tailscale Serve.
# ECC_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required to bind to a specific non-loopback address (a Tailscale IP, for example). This
# application has no login: anyone who reaches the port gets a shell. Wildcard addresses
# (0.0.0.0, ::) are always refused.
# ECC_ALLOW_REMOTE_BIND=true

# tmux binary, and an optional dedicated server socket name (tmux -L). Leave the socket
# unset to share the default server with sessions you create over SSH.
# ECC_TMUX_BIN=/usr/bin/tmux
# ECC_TMUX_SOCKET=ecc

# Private directory for the Claude Code hook token. If you change it, also set it when running
# pnpm claude-hooks install.
# ECC_STATE_DIR=~/.config/engineering-control-center

# Claude Code's user directory, read by the Configuration tab. Defaults to ~/.claude.
# CLAUDE_CONFIG_DIR=/home/dev/.claude

# Markdown directories to show in the Configuration tab. Absolute entries appear in the global
# scope, and relative entries inside each project.
# ECC_CLAUDE_KNOWLEDGE_DIRS=/home/dev/kb,docs/kb

# Directories that symlinks in Claude Code configuration may point into. Others are not followed.
# ECC_CLAUDE_SYMLINK_TARGETS=/home/dev/claude-config
